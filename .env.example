# Copy this file to .env and fill in real values for your environment.
# Never commit the actual .env file.

ENVIRONMENT=development

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/academic_predictor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=academic_predictor

# Auth
SECRET_KEY=replace_with_a_long_random_value_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated list consumed as JSON array by pydantic-settings)
CORS_ORIGINS=["http://localhost:3000"]

# ML
MODEL_REGISTRY_DIR=../ml/inference/registry

# Frontend (Next.js) — consumed client-side, must be prefixed NEXT_PUBLIC_
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
